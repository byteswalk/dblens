/target
**/*.rs.bk
.env
.idea/
.vscode/
node_modules/

# 前端构建产物
/web/dist/
# 生成的 PL/SQL 解析器（web/scripts/gen-plsql.mjs）
/web/src/features/sql/plsql/gen/
# 生成的 T-SQL 解析器（web/scripts/gen-tsql.mjs）
/web/src/features/sql/tsql/gen/
# tauri-build 生成的权限描述
/crates/dblens-desktop/gen/
# tauri-build 按 build.rs 中的命令列表自动生成的权限定义
/crates/dblens-desktop/permissions/autogenerated/

# 单独测试 vendor/ 中的库时生成
/vendor/*/Cargo.lock
/vendor/*/target/

# 桥接进程和打包时生成的客户端目录
/bridge/build/
/clients-staging/
