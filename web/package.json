{
  "name": "dblens-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "gen": "node scripts/gen-plsql.mjs && node scripts/gen-tsql.mjs",
    "dev": "node scripts/gen-plsql.mjs && node scripts/gen-tsql.mjs && vite",
    "build": "node scripts/gen-plsql.mjs && node scripts/gen-tsql.mjs && tsc --noEmit && vite build",
    "test": "node scripts/gen-plsql.mjs && node scripts/gen-tsql.mjs && vitest run",
    "typecheck": "node scripts/gen-plsql.mjs && node scripts/gen-tsql.mjs && tsc --noEmit",
    "tauri": "cd .. && tauri",
    "package": "cd .. && node scripts/build-bridge.mjs && node scripts/prepare-clients.mjs && tauri build --config crates/dblens-desktop/tauri.bundle.json"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@dagrejs/dagre": "3.1.1",
    "@glideapps/glide-data-grid": "6.0.3",
    "@monaco-editor/react": "4.7.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.12.0",
    "antd": "6.6.7",
    "antlr4-c3": "3.4.4",
    "antlr4ng": "3.0.16",
    "dt-sql-parser": "4.5.1",
    "elkjs": "0.12.0",
    "html-to-image": "1.11.11",
    "i18next": "26.5.6",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.4",
    "react-resizable-panels": "4.14.8",
    "simple-icons": "16.35.0",
    "sql-formatter": "15.9.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "antlr-ng": "1.0.10",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
