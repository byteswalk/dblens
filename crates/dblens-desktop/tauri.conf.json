{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBLens",
  "identifier": "com.dblens.desktop",
  "build": {
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../web"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "DBLens",
    "copyright": "Copyright © 2026 DBLens",
    "category": "DeveloperTool",
    "shortDescription": "数洞：跨平台数据库管理工具",
    "longDescription": "数洞（DBLens）是支持 MySQL 系、PostgreSQL 系、Oracle 和达梦的跨平台数据库管理工具。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RDVBRTY5OTM2MjQ0NkIKUldSclJHS1RhYTdWS2JhM1A4QkZrSjR6eXI3dmp3RHdpOTRHRFFGM3FYb1VCRStISENYK25DMjAK",
      "endpoints": [
        "https://github.com/byteswalk/dblens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
