       TRIM(c.colname) AS column_name, 16 AS position,
       TRIM(rt.owner) AS ref_schema, TRIM(rt.tabname) AS ref_table, TRIM(rc.colname) AS ref_column,
       CASE WHEN k.constrtype <> 'R' THEN NULL WHEN r.delrule = 'C' THEN 'CASCADE' ELSE 'NO ACTION' END AS on_delete,
       CASE WHEN k.constrtype <> 'R' THEN NULL ELSE 'NO ACTION' END AS on_update
FROM sysconstraints k
JOIN systables t ON t.tabid = k.tabid
JOIN sysindexes x ON x.idxname = k.idxname AND x.tabid = k.tabid
JOIN syscolumns c ON c.tabid = k.tabid AND c.colno = ABS(x.part16)
LEFT JOIN sysreferences r ON r.constrid = k.constrid
LEFT JOIN systables rt ON rt.tabid = r.ptabid
LEFT JOIN sysconstraints pk ON pk.constrid = r."primary"
LEFT JOIN sysindexes px ON px.idxname = pk.idxname AND px.tabid = pk.tabid
LEFT JOIN syscolumns rc ON rc.tabid = r.ptabid AND rc.colno = ABS(px.part16)
WHERE k.constrtype IN ('P', 'U', 'R') AND t.owner = ?
  AND t.tabname = ?
ORDER BY 1, 2, 5

-- [checks] [String("HR"), String("EMP")]
SELECT TRIM(t.tabname) AS table_name, TRIM(k.constrname) AS constraint_name, c.checktext AS expression
FROM sysconstraints k
JOIN systables t ON t.tabid = k.tabid
JOIN syschecks c ON c.constrid = k.constrid AND c.type = 'T'
WHERE k.constrtype = 'C' AND t.owner = ?
  AND t.tabname = ?
ORDER BY 1, 2, c.seqno

-- [indexes] [String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP"), String("HR"), String("EMP")]
-- Indexes that back a constraint are excluded: they appear as keys.
SELECT TRIM(t.tabname) AS table_name, TRIM(x.idxname) AS index_name,
       CASE WHEN x.idxtype = 'U' THEN 't' ELSE 'f' END::BOOLEAN AS is_unique,
       CAST(NULL AS VARCHAR(1)) AS method, TRIM(c.colname) AS column_expr, 1 AS position,
       CASE WHEN x.part1 < 0 THEN 't' ELSE 'f' END::BOOLEAN AS descending
FROM sysindexes x
JOIN systables t ON t.tabid = x.tabid
JOIN syscolumns c ON c.tabid = x.tabid AND c.colno = ABS(x.part1)
WHERE t.tabid >= 100 AND t.owner = ?
  AND NOT EXISTS (SELECT 1 FROM sysconstraints k WHERE k.idxname = x.idxname AND k.tabid = x.tabid)
  AND t.tabname = ?
UNION ALL SELECT TRIM(t.tabname) AS table_name, TRIM(x.idxname) AS index_name,
       CASE WHEN x.idxtype = 'U' THEN 't' ELSE 'f' END::BOOLEAN AS is_unique,
       CAST(NULL AS VARCHAR(1)) AS method, TRIM(c.colname) AS column_expr, 2 AS position,
       CASE WHEN x.part2 < 0 THEN 't' ELSE 'f' END::BOOLEAN AS descending
FROM sysindexes x
JOIN systables t ON t.tabid = x.tabid
JOIN syscolumns c ON c.tabid = x.tabid AND c.colno = ABS(x.part2)
WHERE t.tabid >= 100 AND t.owner = ?
  AND NOT EXISTS (SELECT 1 FROM sysconstraints k WHERE k.idxname = x.idxname AND k.tabid = x.tabid)
  AND t.tabname = ?
UNION ALL SELECT TRIM(t.tabname) AS table_name, TRIM(x.idxname) AS index_name,
       CASE WHEN x.idxtype = 'U' THEN 't' ELSE 'f' END::BOOLEAN AS is_unique,
       CAST(NULL AS VARCHAR(1)) AS method, TRIM(c.colname) AS column_expr, 3 AS position,
       CASE WHEN x.part3 < 0 THEN 't' ELSE 'f' END::BOOLEAN AS descending
FROM sysindexes x
JOIN systables t ON t.tabid = x.tabid
JOIN syscolumns c ON c.tabid = x.tabid AND c.colno = ABS(x.part3)
WHERE t.tabid >= 100 AND t.owner = ?
  AND NOT EXISTS (SELECT 1 FROM sysconstraints k WHERE k.idxname = x.idxname AND k.tabid = x.tabid)
  AND t.tabname = ?
UNION ALL SELECT TRIM(t.tabname) AS table_name, TRIM(x.idxname) AS index_name,
       CASE WHEN x.idxtype = 'U' THEN 't' ELSE 'f' END::BOOLEAN AS is_unique,
       CAST(NULL AS VARCHAR(1)) AS method, TRIM(c.colname) AS column_expr, 4 AS position,
       CASE WHEN x.part4 < 0 THEN 't' ELSE 'f' END::BOOLEAN AS descending
FROM sysindexes x
JOIN systables t ON t.tabid = x.tabid
JOIN syscolumns c ON c.tabid = x.tabid AND c.colno = ABS(x.part4)
WHERE t.tabid >= 100 AND t.owner = ?
  AND NOT EXISTS (SELECT 1 FROM sysconstraints k WHERE k.idxname = x.idxname AND k.tabid = x.tabid)
  AND t.tabname = ?
UNION ALL SELECT TRIM(t.tabname) AS table_name, TRIM(x.idxname) AS index_name,
       CASE WHEN x.idxtype = 'U' THEN 't' ELSE 'f' END::BOOLEAN AS is_unique,
       CAST(NULL AS VARCHAR(1)) AS method, TRIM(c.colname) AS column_expr, 5 AS position,
       CASE WHEN x.part5 < 0 THEN 't' ELSE 'f' END::BOOLEAN AS descending
FROM sysindexes x
JOIN systables t ON t.tabid = x.tabid
JOIN syscolumns c ON c.tabid = x.tabid AND c.colno = ABS(x.part5)
WHERE t.tabid >= 100 AND t.owner = ?
  AND NOT EXISTS (SELECT 1 FROM sysconstraints k WHERE k.idxname = x.idxname AND k.tabid = x.tabid)
  AND t.tabname = ?
UNION ALL SELECT TRIM(t.tabname) AS table_name, TRIM(x.idxname) AS index_name,
       CASE WHEN x.idxtype = 'U' THEN 't' ELSE 'f' END::BOOLEAN AS is_unique,
       CAST(NULL AS VARCHAR(1)) AS method, TRIM(c.colname) AS column_expr, 6 AS position,
       CASE WHEN x.part6 < 0 THEN 't' ELSE 'f' END::BOOLEAN AS descending
FROM sysindexes x
JOIN systables t ON t.tabid = x.tabid
JOIN syscolumns c ON c.tabid = x.tabid AND c.colno = ABS(x.part6)
WHERE t.tabid >= 100 AND t.owner = ?
  AND NOT EXISTS (SELECT 1 FROM sysconstraints k WHERE k.idxname = x.idxname AND k.tabid = x.tabid)
