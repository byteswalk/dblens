---
source: crates/dblens-dialect/tests/meta_snapshots.rs
expression: out
---
-- [schemas] [String("%员工%")]
SELECT name, 0 AS is_system
FROM pragma_database_list
WHERE name <> 'temp'
  AND UPPER(name) LIKE UPPER(?) ESCAPE '!'
ORDER BY seq

-- [tables] [String("EMP"), String("%员工%")]
SELECT m.name, NULL AS comment, NULL AS partition
FROM "HR".sqlite_schema m
WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite!_%' ESCAPE '!'
  AND m.name = ?
  AND UPPER(m.name) LIKE UPPER(?) ESCAPE '!'
ORDER BY m.name

-- [views] [String("%员工%")]
SELECT m.name, NULL AS comment
FROM "HR".sqlite_schema m
WHERE m.type = 'view'
  AND UPPER(m.name) LIKE UPPER(?) ESCAPE '!'
ORDER BY m.name

-- [columns] [String("HR"), String("HR"), String("HR"), String("EMP")]
-- hidden: 0 normal, 1 hidden column of a virtual table (skipped), 2 VIRTUAL generated, 3 STORED generated.
-- auto_increment: the single-column INTEGER PRIMARY KEY of a rowid table is an alias of the rowid.
SELECT m.name AS table_name,
       c.name,
       c.cid + 1 AS ordinal,
       c.type AS type_text,
       NOT c."notnull" AS nullable,
       c.dflt_value AS default_value,
       NULL AS comment,
       (m.type = 'table' AND c.pk = 1 AND UPPER(c.type) = 'INTEGER'
        AND (SELECT COUNT(*) FROM pragma_table_xinfo(m.name, ?) k WHERE k.pk > 0) = 1
        AND NOT EXISTS (SELECT 1 FROM pragma_table_list l
                        WHERE l.schema = ? AND l.name = m.name AND l.wr = 1)) AS auto_increment,
       CASE c.hidden WHEN 2 THEN 'VIRTUAL' WHEN 3 THEN 'STORED' END AS generated
FROM "HR".sqlite_schema m
JOIN pragma_table_xinfo(m.name, ?) c
WHERE m.type IN ('table', 'view') AND m.name NOT LIKE 'sqlite!_%' ESCAPE '!'
  AND c.hidden <> 1
  AND m.name = ?
ORDER BY m.name, c.cid

-- [keys] [String("HR"), String("EMP"), String("HR"), String("HR"), String("EMP"), String("HR"), String("HR"), String("HR"), String("EMP")]
-- Primary key from table_xinfo.pk, UNIQUE constraints from index_list (origin 'u'), foreign keys from
-- foreign_key_list (a NULL "to" means the referenced table's primary key).
SELECT * FROM (
  SELECT m.name AS table_name, 'pk' AS constraint_name, 'P' AS constraint_type, c.name AS column_name,
         c.pk AS position, NULL AS ref_schema, NULL AS ref_table, NULL AS ref_column,
         NULL AS on_delete, NULL AS on_update
  FROM "HR".sqlite_schema m
  JOIN pragma_table_xinfo(m.name, ?) c
  WHERE m.type = 'table' AND c.pk > 0
    AND m.name = ?
  UNION ALL
  SELECT m.name, 'u:' || il.name, 'U', ii.name, ii.seqno + 1, NULL, NULL, NULL, NULL, NULL
  FROM "HR".sqlite_schema m
  JOIN pragma_index_list(m.name, ?) il
  JOIN pragma_index_info(il.name, ?) ii
  WHERE m.type = 'table' AND il.origin = 'u'
    AND m.name = ?
  UNION ALL
  SELECT m.name, printf('fk:%04d', fk.id), 'F', fk."from", fk.seq + 1, ?, fk."table",
         COALESCE(fk."to", (SELECT p.name FROM pragma_table_xinfo(fk."table", ?) p
                            WHERE p.pk = fk.seq + 1)),
         fk.on_delete, fk.on_update
  FROM "HR".sqlite_schema m
  JOIN pragma_foreign_key_list(m.name, ?) fk
  WHERE m.type = 'table'
    AND m.name = ?
)
ORDER BY table_name, constraint_name, position

-- [checks] [String("EMP")]
-- One row per table; expression is the whole CREATE TABLE, parsed by the assembler (CHECK constraints, generated
-- expressions and constraint names all come from it).
SELECT m.name AS table_name, NULL AS constraint_name, m.sql AS expression
FROM "HR".sqlite_schema m
WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite!_%' ESCAPE '!'
  AND m.name = ?
ORDER BY m.name

-- [indexes] [String("HR"), String("HR"), String("EMP")]
-- CREATE INDEX only (origin 'c'); key columns only (key = 1). An expression column has cid -2 and no name: the
-- assembler takes it from index_sql.
SELECT m.name AS table_name,
       il.name AS index_name,
       il."unique" AS is_unique,
       NULL AS method,
       x.name AS column_expr,
       x.seqno + 1 AS position,
       x."desc" AS descending,
       x.cid AS cid,
       s.sql AS index_sql
FROM "HR".sqlite_schema m
JOIN pragma_index_list(m.name, ?) il
JOIN pragma_index_xinfo(il.name, ?) x
JOIN "HR".sqlite_schema s ON s.type = 'index' AND s.name = il.name
WHERE m.type = 'table' AND il.origin = 'c' AND x.key = 1
  AND m.name = ?
ORDER BY m.name, il.name, x.seqno

-- [triggers] [String("EMP")]
-- timing and events are read from the CREATE TRIGGER text by the assembler.
SELECT m.tbl_name AS table_name, m.name, NULL AS timing, '' AS events, m.sql AS definition
FROM "HR".sqlite_schema m
WHERE m.type = 'trigger'
  AND m.tbl_name = ?
ORDER BY m.tbl_name, m.name

-- [view_definition] [String("EMP")]
SELECT m.sql AS definition
FROM "HR".sqlite_schema m
WHERE m.type = 'view' AND m.name = ?

-- [referencing_keys] [String("HR"), String("HR"), String("HR"), String("EMP"), String("EMP")]
-- Table designer rebuild: foreign keys of OTHER tables that reference this table.
SELECT ? AS table_schema,
       m.name AS table_name,
       printf('fk:%04d', fk.id) AS constraint_name,
       fk."from" AS column_name,
       fk.seq + 1 AS position,
       COALESCE(fk."to", (SELECT p.name FROM pragma_table_xinfo(fk."table", ?) p
                          WHERE p.pk = fk.seq + 1)) AS ref_column,
       fk.on_delete,
       fk.on_update
FROM "HR".sqlite_schema m
JOIN pragma_foreign_key_list(m.name, ?) fk
WHERE m.type = 'table' AND fk."table" = ? COLLATE NOCASE AND m.name <> ?
ORDER BY m.name, fk.id, fk.seq

-- [dependent_views] [String("HR"), String("EMP")]
-- Views reference tables by name; a view whose text mentions the table is reported (may over-report).
SELECT ? AS schema_name, m.name, 'VIEW' AS kind
FROM "HR".sqlite_schema m
WHERE m.type = 'view' AND instr(lower(m.sql), lower(?)) > 0
ORDER BY m.name

-- [table_storage] [String("EMP")]
-- No cheap row estimate (sqlite_stat1 exists only after ANALYZE); the ops page has sizes from dbstat.
SELECT NULL AS engine, NULL AS "charset", NULL AS "collation", NULL AS tablespace, NULL AS row_count
FROM "HR".sqlite_schema m
WHERE m.type = 'table' AND m.name = ?

-- [lint_tables] []
-- Design lint: no engine or charset; no cheap row estimate.
SELECT m.name, NULL AS engine, NULL AS "charset", NULL AS row_count
FROM "HR".sqlite_schema m
WHERE m.type = 'table' AND m.name NOT LIKE 'sqlite!_%' ESCAPE '!'
