CREATE TABLE app.DOCS (
    ID BIGINT NOT NULL AUTO_INCREMENT,
    NO BIGINT NULL,
    TITLE VARCHAR(200) NULL,
    BODY LONGTEXT NULL,
    CREATED DATETIME(0) NULL DEFAULT CURRENT_TIMESTAMP,
