---
name: orders
comment: 订单
columns:
- name: id
  type: bigint
  nullable: false
  auto_increment: true
- name: code
  type: varchar(20)
- name: amount
  type: numeric(10,2)
  default: "0"
  comment: |-
    金额
    （含税）
primary_key:
  columns:
  - id
uniques:
- name: uk_code
  columns:
  - code
foreign_keys:
- name: fk_cust
  columns:
  - code
  ref_schema: crm
  ref_table: customers
  ref_columns:
  - code
  on_delete: CASCADE
checks:
