{
  "id": "analytical",
  "name": "Analytical",
  "builtin": true,
  "clauses": [
    {
      "id": "naming.charset",
      "section": "naming",
      "text": "Object names use letters, digits and underscores, and start with a letter",
      "enabled": true,
      "severity": "error",
      "rules": [
        {
          "id": "name.charset"
        }
      ]
    },
    {
      "id": "naming.length",
      "section": "naming",
      "text": "Tables ≤56, columns ≤64, other names ≤48",
      "enabled": true,
      "severity": "error",
      "rules": [
        {
          "id": "name.max_length",
          "params": {
            "max": 56,
            "target": "table"
          }
        },
        {
          "id": "name.max_length",
          "params": {
            "max": 64,
            "target": "column"
          }
        },
        {
          "id": "name.max_length",
          "params": {
            "max": 48,
            "target": "index"
          }
        },
        {
          "id": "name.max_length",
          "params": {
            "max": 48,
            "target": "other"
          }
        },
        {
          "id": "name.max_length",
          "params": {
            "max": 48,
            "target": "schema"
          }
        }
      ]
    },
    {
      "id": "naming.case",
      "section": "naming",
      "text": "Object names are uppercase",
      "enabled": true,
      "severity": "warning",
      "rules": [
        {
          "id": "name.case",
          "params": {
            "case": "upper"
          }
        }
      ]
    },
    {
      "id": "naming.reserved",
      "section": "naming",
      "text": "Do not use a reserved word alone as an object name",
      "enabled": true,
      "severity": "error",
      "rules": [
        {
          "id": "name.reserved"
        }
      ]
    },
    {
      "id": "naming.quoted",
      "section": "naming",
      "text": "Do not create objects with quoted names",
